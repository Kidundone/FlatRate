{
  "appId": "dev.nellylabs.flatrate",
  "appName": "FR Buddy",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#000000"
  },
  "android": {
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "Haptics": {},
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#22c55e",
      "sound": "beep.wav"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
